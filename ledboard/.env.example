# Image tag to run. "main" tracks the default branch; pin to sha-abc1234 to roll back.
LEDBOARD_TAG=main

# gid of the gpio group on this Pi: getent group gpio | cut -d: -f3
GPIO_GID=986

# Panel geometry: two 64x32 panels chained horizontally.
LEDBOARD_WIDTH=128
LEDBOARD_HEIGHT=32

# Apps, highest priority wins when several want the screen. bus shows departures when
# it has any and yields otherwise; etch is the sketch background under bus and text.
LEDBOARD_APPS=text,bus,etch,clock

# Bus board. Stop id is the five-digit code on the pole (59378 = St Giles Church) or a naptan
# id. Leave routes empty for every route at the stop. Windows are Europe/London (the image sets
# TZ), so 06:00-09:00 means 6-9am BST in summer and GMT in winter. Empty = always on; add more
# spans comma separated, e.g. 06:00-09:00,17:00-20:00.
LEDBOARD_BUS_STOP_ID=59378
LEDBOARD_BUS_ROUTES=
LEDBOARD_BUS_WINDOWS=06:00-09:00
# Optional. Unauthenticated is 50 req/min, and the board polls twice a minute.
LEDBOARD_BUS_API_KEY=

# Etch-a-sketch stylus colour.
LEDBOARD_ETCH_COLOR=#FFFFFF

# 0..1, gamma-aware.
LEDBOARD_BRIGHTNESS=0.8

# POST /text limits. Senders pick how long a message shows (duration_s); this caps it. Short text
# with no duration holds for TEXT_DWELL_S, long text scrolls once.
LEDBOARD_TEXT_MAX_LEN=200
LEDBOARD_TEXT_MAX_DURATION_S=300
LEDBOARD_TEXT_DWELL_S=4
LEDBOARD_RATE_LIMIT_PER_MIN=10

# Auth for POST /text. Comma list of Clerk frontend API urls whose tokens are trusted; empty
# leaves the endpoint open. Both home-dash instances post here:
#   clerk.worm.beer             production instance (worm.beer)
#   clean-dinosaur-8235…        development instance (staging.worm.beer, previews, localhost)
LEDBOARD_AUTH_ISSUER=https://clerk.worm.beer,https://clean-dinosaur-8235.clerk.accounts.dev
# Origins allowed to mint tokens (the azp claim). The etch endpoints take no login but only
# accept browser Origin/Referer matching an entry here. Comma separated, exact match, no
# trailing slashes. home-dash proxies etch and forwards the browser's headers, so its calls
# are checked against this same list.
#   worm.beer          production
#   staging.worm.beer  every commit on home-dash's main
#   home-dash-pink…    Vercel's stable production alias
# PR previews get a fresh *.vercel.app host each time, so they cannot be listed and their
# etch calls will 403 here.
LEDBOARD_AUTH_AUTHORIZED_PARTIES=https://worm.beer,https://staging.worm.beer,https://home-dash-pink.vercel.app,http://localhost:3000

LEDBOARD_LOG_LEVEL=info
